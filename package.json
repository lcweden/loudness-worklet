{
  "name": "loudness-worklet",
  "version": "2.2.0",
  "description": "A lightweight and efficient AudioWorklet for real-time loudness measurement in the browser, compliant with the ITU-R BS.1770-5 standard.",
  "keywords": [
    "audio-worklet",
    "ebu-r128",
    "itu-r-bs1770",
    "loudness",
    "web-audio"
  ],
  "homepage": "https://lcweden.github.io/loudness-worklet/",
  "bugs": {
    "url": "https://github.com/lcweden/loudness-worklet/issues"
  },
  "license": "MIT",
  "author": "lcweden",
  "repository": {
    "type": "git",
    "url": "https://github.com/lcweden/loudness-worklet.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "packages/library/dist"
  ],
  "type": "module",
  "main": "./packages/library/dist/index.js",
  "types": "./packages/library/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/library/dist/index.d.ts",
      "default": "./packages/library/dist/index.js"
    },
    "./loudness.worklet": "./packages/library/dist/loudness.worklet.js"
  },
  "devDependencies": {
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
